{
  "name": "edu-platform-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "check:forbidden": "node scripts/check-forbidden.js",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:forbidden && pnpm test:unit",
    "verify:full": "pnpm verify && pnpm test:int",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts --catalog",
    "seed:demo": "tsx scripts/seed.ts --catalog --demo",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "sessions:revoke": "tsx scripts/revoke-sessions.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@serwist/next": "9.5.12",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns-jalali": "4.4.0-0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.12",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.2",
    "vazirmatn": "33.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=10"
  }
}
