# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; the example is the only allowed one
.env*
!.env.example

# local uploads / data
/uploads
/data

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# service worker: generated by scripts/build-sw.ts at `pnpm build`
/public/sw.js
/public/sw-routing.js

# deploy-time catalog seed: generated by scripts/build-seed-catalog.ts at `pnpm build` (the `seed` compose service)
/scripts/seed-catalog.js

# import CLI: pre-commit dumps and credential CSVs (plaintext!) — never commit
/backups

# cPanel release packaging output (scripts/package-release.mjs) — never committed
/release
/release-test

# GitHub Pages static preview output (scripts/preview/export.ts, .github/workflows/pages.yml)
/preview
