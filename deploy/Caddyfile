# ArvanCloud CDN may sit in front of this origin, so a request's TCP peer can be an Arvan edge. X-Forwarded-For is
# trusted ONLY from Arvan's edge ranges, and strict mode takes its right-most entry that is not an Arvan address (the
# hop Arvan appended). Any other peer (e.g. a direct hit on the VPS IP) is itself the client; its X-Forwarded-For is
# ignored. Ranges = Arvan's official list https://www.arvancloud.ir/fa/ips.txt (same as /en/ips.txt), fetched
# 2026-10-06: 14 IPv4 CIDRs, no IPv6. Refresh this line whenever Arvan changes its ranges (deploy/README.md).
{
	# An origin fetch that names no site in its TLS handshake (some CDNs' origin pulls) still gets this site's cert.
	default_sni {$PUBLIC_HOST}
	servers {
		trusted_proxies static 185.143.232.0/22 188.229.116.16/30 94.101.182.0/27 2.144.3.128/28 37.32.16.0/27 37.32.17.0/27 37.32.18.0/27 37.32.19.0/27 185.215.232.0/22 178.131.120.48/28 94.101.183.0/28 78.157.36.112/28 95.38.61.80/28 193.24.119.0/29
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		# A whole request (headers + body) must be READ within 2 minutes — until now a body could trickle forever
		# (security review 2026-10-19, D2). Go's ReadTimeout: once the body is read the deadline is cleared, so long
		# downloads are not cut. Kept above the app's own upload wall clock (90 s, src/modules/files/limits.ts) so the
		# app answers first, in Persian; Node's requestTimeout (300 s) is the last line behind both.
		timeouts {
			read_body 120s
		}
	}
}

{$PUBLIC_HOST} {
	encode gzip

	request_body {
		max_size 12MB
	}

	# The `-Server` deletion defers this block to write time, so every value in it OVERWRITES the app's. HSTS and
	# nosniff are the same everywhere; X-Frame-Options and Referrer-Policy are only DEFAULTS (`?` = set when the response
	# has none): the app sends its own on every response, and GET /files/<id> must keep its `Referrer-Policy:
	# no-referrer` (security review 2026-10-19, D1). One `?` field per directive — several `?` fields in ONE block
	# share a single "all of them absent" condition.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}
	header ?X-Frame-Options DENY
	header ?Referrer-Policy strict-origin-when-cross-origin

	reverse_proxy app:3000 {
		# The app throttles logins on the FIRST X-Forwarded-For value (src/lib/request.ts): send exactly one, the
		# client IP computed above. Without this a trusted hop forwards "<client-supplied>, <client>" and the forged
		# left-most value wins.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		# Trust Arvan for the client IP only: Host and scheme stay what Caddy itself saw (as before Arvan), so a
		# client-supplied X-Forwarded-Host/-Proto never reaches Next.js. Caddy logs "Unnecessary header_up" for these
		# two at load; that hint assumes no trusted proxies. Keep them.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
