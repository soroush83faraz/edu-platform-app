# /srv/school/.env  — روی سرور؛ هرگز در git. با `chmod 600 .env`.

# ---- ایمیج و دامنه ----
APP_IMAGE=edu-app:CHANGE_ME_SHA        # deploy.sh این را به‌روز می‌کند
APP_VERSION=CHANGE_ME_SHA
PUBLIC_HOST=school.example.ir          # دامنه برای Caddy (یا <ip>.sslip.io)
PUBLIC_ORIGIN=https://school.example.ir

# ---- Postgres (initdb فقط بار اول اجرا می‌شود) ----
POSTGRES_PASSWORD=CHANGE_ME
APP_OWNER_PASSWORD=CHANGE_ME
APP_RW_PASSWORD=CHANGE_ME
APP_BACKUP_PASSWORD=CHANGE_ME

# ---- اتصال برنامه (نام سرویس db، بدون پورت عمومی) ----
DATABASE_URL=postgres://app_rw:CHANGE_ME@db:5432/app
# سقف اتصال‌های استخر pg در فرایند app (پیش‌فرض 20 برای VPS چهار vCPU؛ max_connections=100 در compose.yml) — docs/ops/capacity.md
# DB_POOL_MAX=20
MIGRATION_DATABASE_URL=postgres://app_owner:CHANGE_ME@db:5432/app
BACKUP_DATABASE_URL=postgres://app_backup:CHANGE_ME@db:5432/app
# فقط اگر تست یکپارچه روی سرور اجرا می‌کنید (معمولاً خالی بماند)
# DATABASE_URL_TEST=postgres://app_rw:CHANGE_ME@db:5432/app_test
# MIGRATION_DATABASE_URL_TEST=postgres://app_owner:CHANGE_ME@db:5432/app_test

# ---- برنامه ----
NODE_ENV=production
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# الزامی — AES-256-GCM برای رمزهای اولیهٴ حساب‌ها (چاپ اعتبارنامه). ۶۴ نویسهٴ هگز:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INITIAL_PASSWORD_KEY=CHANGE_ME_64_HEX_CHARACTERS
LOG_LEVEL=info
FILES_DIR=/data/files
# SEED_ALLOW=
# SEED_DEMO=
# SMS_API_KEY=

# ---- بکاپ شبانه (backup.sh) و watchdog.sh — deploy/README.md ----
AGE_RECIPIENT=age1CHANGE_ME              # فقط کلید عمومی؛ کلید خصوصی روی لپ‌تاپ + پاکت
RCLONE_REMOTE=arvan:school-backups       # remote در ~deploy/.config/rclone/rclone.conf
# ALERT_WEBHOOK=https://...              # POST JSON هشدارهای watchdog
# KAVENEGAR_API_KEY=                     # + ALERT_PHONE=0912... (و ALERT_SENDER اختیاری) → پیامک
# ALERT_PHONE=
