# /srv/school/.env  — روی سرور؛ هرگز در git. با `chmod 600 .env`.

# ---- ایمیج و دامنه ----
APP_IMAGE=edu-app:CHANGE_ME_SHA        # deploy.sh این را به‌روز می‌کند
APP_VERSION=CHANGE_ME_SHA
PUBLIC_HOST=school.example.ir          # دامنه برای Caddy (یا <ip>.sslip.io)
PUBLIC_ORIGIN=https://school.example.ir

# ---- Postgres (initdb فقط بار اول اجرا می‌شود) ----
POSTGRES_PASSWORD=CHANGE_ME
APP_OWNER_PASSWORD=CHANGE_ME
APP_RW_PASSWORD=CHANGE_ME
APP_BACKUP_PASSWORD=CHANGE_ME

# ---- اتصال برنامه (نام سرویس db، بدون پورت عمومی) ----
DATABASE_URL=postgres://app_rw:CHANGE_ME@db:5432/app
MIGRATION_DATABASE_URL=postgres://app_owner:CHANGE_ME@db:5432/app
BACKUP_DATABASE_URL=postgres://app_backup:CHANGE_ME@db:5432/app
# فقط اگر تست یکپارچه روی سرور اجرا می‌کنید (معمولاً خالی بماند)
# DATABASE_URL_TEST=postgres://app_rw:CHANGE_ME@db:5432/app_test
# MIGRATION_DATABASE_URL_TEST=postgres://app_owner:CHANGE_ME@db:5432/app_test

# ---- برنامه ----
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
LOG_LEVEL=info
FILES_DIR=/data/files
# SEED_ALLOW=
# SEED_DEMO=
# SMS_API_KEY=
