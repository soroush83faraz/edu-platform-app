# ---- کپی کنید به .env (هرگز .env را commit نکنید) ----

NODE_ENV=development

# اتصال برنامه با نقش app_rw (NOSUPERUSER NOBYPASSRLS — RLS اعمال می‌شود)
DATABASE_URL=postgres://app_rw:change-me@localhost:5432/app

# اتصال مهاجرت/سید با نقش مالک اسکیما app_owner (فقط scripts/migrate و scripts/seed)
MIGRATION_DATABASE_URL=postgres://app_owner:change-me@localhost:5432/app

# حداقل ۳۲ کاراکتر تصادفی:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx

# آدرس عمومی سایت بدون اسلش پایانی (برای کوکی/CSRF/لینک‌ها)
PUBLIC_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# مسیر ذخیرهٴ فایل‌ها روی دیسک (در Docker به volume وصل می‌شود)
FILES_DIR=/data/files

# فقط برای اجرای seed روی production مقدار 1 بدهید
# SEED_ALLOW=1
# فقط برای ساخت سازمان‌های دمو مقدار 1 بدهید
# SEED_DEMO=1

# کلید پنل پیامک (فاز بعد؛ فعلاً اختیاری)
# SMS_API_KEY=

# نسخهٴ اپ (تگ ایمیج = git sha؛ توسط deploy تنظیم می‌شود)
# APP_VERSION=dev
