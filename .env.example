# ---- کپی کنید به .env (هرگز .env را commit نکنید) ----

NODE_ENV=development

# ---- دیتابیس محلی: `pnpm db:up` (docker-compose.dev.yml، پورت 15433) ----
# رمزهای نقش‌ها؛ فقط در اولین اجرای کانتینر (volume خالی) خوانده می‌شوند (deploy/db/initdb/01-roles.sh)
APP_OWNER_PASSWORD=app_owner_dev
APP_RW_PASSWORD=app_rw_dev
APP_BACKUP_PASSWORD=app_backup_dev
APP_WORKER_PASSWORD=app_worker_dev

# اتصال برنامه با نقش app_rw (NOSUPERUSER NOBYPASSRLS — RLS اعمال می‌شود)
DATABASE_URL=postgres://app_rw:app_rw_dev@localhost:15433/app
# سقف اتصال‌های استخر pg در همین یک فرایند (پیش‌فرض 20؛ سنجش بار در docs/ops/capacity.md)
# DB_POOL_MAX=20

# اتصال مهاجرت/سید با نقش مالک اسکیما app_owner (فقط scripts/migrate و scripts/seed)
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:15433/app

# اتصال فقط‌خواندنی برای pg_dump (نقش app_backup: فقط SELECT + BYPASSRLS — همهٴ مستأجرها را می‌خواند؛ مثل رمز نگه دارید)
BACKUP_DATABASE_URL=postgres://app_backup:app_backup_dev@localhost:15433/app

# اتصال کارگرِ پس‌زمینه (`pnpm worker`) با نقش خودش app_worker (مهاجرت 0032): تنها نقشی که کارها را از همهٴ سازمان‌ها
# برمی‌دارد (app.claim_jobs) و ops.schedule را می‌نویسد. خالی = کارگر با DATABASE_URL (app_rw) وصل می‌شود تا نقش ساخته شود.
# روی دیتابیس توسعه‌ای که پیش از این تغییر ساخته شده، نقش را یک‌بار با SQLِ deploy/README.md «نقش app_worker» بسازید.
WORKER_DATABASE_URL=postgres://app_worker:app_worker_dev@localhost:15433/app

# دیتابیس تست (pnpm test:int / pnpm db:reset:test) — همان نقش‌ها، دیتابیس app_test
DATABASE_URL_TEST=postgres://app_rw:app_rw_dev@localhost:15433/app_test
MIGRATION_DATABASE_URL_TEST=postgres://app_owner:app_owner_dev@localhost:15433/app_test
# اختیاری؛ اگر خالی باشد تست‌ها BACKUP_DATABASE_URL را به دیتابیس app_test می‌برند
# BACKUP_DATABASE_URL_TEST=postgres://app_backup:app_backup_dev@localhost:15433/app_test
# اختیاری؛ اگر خالی باشد تست‌ها WORKER_DATABASE_URL را به app_test می‌برند (بی‌آن، کارگرِ تست‌ها app_rw است)
# WORKER_DATABASE_URL_TEST=postgres://app_worker:app_worker_dev@localhost:15433/app_test

# حداقل ۳۲ کاراکتر تصادفی:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx

# کلید AES-256-GCM برای نگهداری موقت رمز اولیهٴ حساب‌ها (چاپ اعتبارنامه). ۳۲ بایت به‌صورت ۶۴ نویسهٴ هگز:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# تغییر کلید، رمزهای اولیهٴ ذخیره‌شده را ناخوانا می‌کند (روی ورود اثری ندارد).
INITIAL_PASSWORD_KEY=replace-with-64-hex-characters-0000000000000000000000000000000000

# آدرس عمومی سایت بدون اسلش پایانی (برای کوکی/CSRF/لینک‌ها)
PUBLIC_ORIGIN=http://localhost:3000
# Optional product name for the manifest, the tab title and /roadmap (default: دانینو).
# PRODUCT_NAME=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# مسیر ذخیرهٴ فایل‌های بارگذاری‌شده («پیوست تکلیف و تحویل پاسخ»). خالی = /data/files در production (volume داکر،
# compose.yml خودش می‌گذارد) و ./.data/files در توسعه (gitignore). روی ویندوز /data/files یعنی ریشهٴ درایو جاری.
# FILES_DIR=/data/files

# فقط برای اجرای seed روی production مقدار 1 بدهید
# SEED_ALLOW=1
# فقط برای ساخت سازمان‌های دمو مقدار 1 بدهید
# SEED_DEMO=1

# «ورود آزمایشی» (فقط دورهٴ آزمایشی؛ docs/decisions.md 2026-10-18): ورود بی‌رمز به حساب‌های سازمان‌های دمو از /login.
# پیش‌فرض خاموش. روشن = هر سه لازم‌اند؛ مالک یک‌بار روی هر دستگاه /login?demo=<کلید> را باز می‌کند.
# حالت باز (تصمیم مالک، فقط با دادهٴ ساختگی): DEMO_LOGIN_OPEN=1 — فقط دقیقاً 1 — دکمه را بی‌کلید به همهٴ بازدیدکنندگان
#   نشان می‌دهد و کلید اختیاری می‌شود. خطر: هر کس نشانی را بداند وارد حساب‌های ساختگی، «مدیر سازمان» هم، می‌شود.
# قبل از مدرسه‌های واقعی همه خاموش و کلید حذف (docs/ops/go-live-checklist.md).
#   کلید (۲۴ تا ۱۲۸ نویسهٴ A-Z a-z 0-9 _ -):  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# DEMO_LOGIN=1
# DEMO_LOGIN_KEY=
# DEMO_LOGIN_ORGS=allameh,farzanegan,helli,pishgaman
# DEMO_LOGIN_OPEN=1

# کلید پنل پیامک (فاز بعد؛ فعلاً اختیاری)
# SMS_API_KEY=

# نسخهٴ اپ (تگ ایمیج = git sha؛ توسط deploy تنظیم می‌شود)
# APP_VERSION=dev
